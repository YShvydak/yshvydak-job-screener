{
    "name": "@yshvydak-job-screener/server",
    "version": "1.0.0",
    "description": "Backend server for yshvydak-job-screener",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc && npm run copy-files",
        "copy-files": "mkdir -p dist/database && cp src/database/schema.sql dist/database/",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "express",
        "sqlite",
        "job-screener"
    ],
    "author": "Yurii Shvydak <y.shvydak@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "@google/genai": "^1.3.0",
        "@yshvydak-job-screener/shared": "^1.0.0",
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^11.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "fast-jwt": "^6.1.0",
        "serpapi": "^2.1.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/better-sqlite3": "^7.6.12",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.0.0",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "supertest": "^7.2.2",
        "tsx": "^4.0.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
