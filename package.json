{
    "name": "yshvydak-job-screener",
    "version": "1.0.0",
    "private": true,
    "description": "AI-powered job search automation with SerpAPI and Gemini AI",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "type-check": "turbo run type-check",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "clean": "turbo run clean && rm -rf node_modules",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.3.0",
        "globals": "^17.1.0",
        "husky": "^9.1.7",
        "prettier": "^3.2.5",
        "turbo": "^2.3.3",
        "typescript": "^5.9.3"
    },
    "packageManager": "npm@10.0.0",
    "workspaces": [
        "packages/*",
        "shared"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=10.0.0"
    },
    "author": "Yurii Shvydak <y.shvydak@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yshvydak/yshvydak-job-screener.git"
    }
}
